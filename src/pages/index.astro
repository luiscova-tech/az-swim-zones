---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/url";
---

<BaseLayout title="Home">
  <h1 class="page-title">Arizona has one of the deepest 14&U pools in the West.</h1>
  <p class="page-subtitle">
    Let's actually take them to Zones. This site is here to make eligibility visible, personal, and
    reachable — for swimmers, families, and coaches.
  </p>

  <div class="card callout">
    <h2 class="card-heading">Start here: is your swimmer already eligible?</h2>
    <p>
      One AAA time in any course is the whole bar. Most families are surprised — a lot of Arizona
      swimmers are already fast enough and nobody has told them.
    </p>
    <p style="margin-bottom:0">
      <a class="button-primary" href={withBase("/calculator")}>Check a time →</a>
    </p>
  </div>

  <div class="tile-grid">
    <a class="tile" href={withBase("/standards")}>
      <span class="tile-title">AAA Standards</span>
      <span class="tile-desc">Every cut, every event, all three courses.</span>
    </a>
    <a class="tile" href={withBase("/faq")}>
      <span class="tile-title">Cost &amp; Travel</span>
      <span class="tile-desc">What the week looks like, and what it costs.</span>
    </a>
    <a class="tile" href={withBase("/about")}>
      <span class="tile-title">About this site</span>
      <span class="tile-desc">Who we are — and what we're not.</span>
    </a>
  </div>

  <p class="note" style="margin-top:1.5rem">
    🚧 The swimmer database, newly-qualified board and Team Builder are still being built. The
    calculator and standards work today and need no data about you at all.
  </p>
</BaseLayout>
